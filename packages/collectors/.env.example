SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Independent cross-process pools: browser calls are long; structured calls are short.
HERMES_BROWSER_MAX_CONCURRENCY=2
# HERMES_BROWSER_CONCURRENCY_LOCK_DIR=/tmp/myboon-hermes-slots
HERMES_STRUCTURED_MAX_CONCURRENCY=4
# HERMES_STRUCTURED_CONCURRENCY_LOCK_DIR=/tmp/myboon-hermes-structured-slots
# Legacy HERMES_MAX_CONCURRENCY/HERMES_CONCURRENCY_LOCK_DIR remain browser fallbacks.
# PM2 pins a dedicated Hermes profile command per LLM-heavy worker. Fresh
# profiles use isolated state databases and avoid cross-worker SQLite writers.
# HERMES_COMMAND=myprofile
# HERMES_ORPHAN_SWEEP_INTERVAL_MS=300000
# HERMES_ORPHAN_MAX_AGE_MS=900000
# HERMES_ORPHAN_KILL_GRACE_MS=5000

# Structured news feed collection
TOKENS_API_KEY=
NEWS_SQLITE_PATH=.data/news.sqlite
NEWS_FEED_RUN_ONCE=0
NEWS_FEED_INTERVAL_MS=600000

# Hermes source-aware news research
NEWS_RESEARCHER_RUN_ONCE=0
NEWS_RESEARCHER_INTERVAL_MS=300000
NEWS_RESEARCHER_BATCH_SIZE=10
NEWS_RESEARCHER_CONCURRENCY=2
NEWS_RESEARCH_TIMEOUT_MS=600000
NEWS_STALE_WORK_CUTOFF_MS=1800000
NEWS_RESEARCH_BACKLOG_WARN_COUNT=20
NEWS_RESEARCH_BACKLOG_WARN_AGE_MS=3600000
# HTTP-only known-URL read first; Hermes browser-only chat is the safe fallback.
NEWS_AGENT_BROWSER_DIRECT_READ_ENABLED=1
NEWS_AGENT_BROWSER_READ_TIMEOUT_MS=30000
NEWS_AGENT_BROWSER_MAX_OUTPUT_CHARS=40000
NEWS_HERMES_BROWSER_FALLBACK_ENABLED=1
NEWS_HERMES_TOOLSETS=browser
# AGENT_BROWSER_COMMAND=agent-browser
ENTITY_MANAGER_NEWS_RUN_ONCE=0
ENTITY_MANAGER_NEWS_INTERVAL_MS=300000
ENTITY_MANAGER_NEWS_BATCH_SIZE=20
ENTITY_MANAGER_HERMES_TIMEOUT_MS=600000

# Optional tuning
ODDS_SHIFT_THRESHOLD=0.05

# Polymarket data collector
POLYMARKET_MARKETS_RUN_ONCE=1
POLYMARKET_MARKETS_PREVIEW_ONLY=0
POLYMARKET_MARKETS_RUN_INTERVAL_MS=7200000
POLYMARKET_MARKETS_TAGS=crypto,politics,geopolitics,economics,finance,business,technology,artificial-intelligence,commodities
POLYMARKET_MARKETS_TOP_PER_TAG=10
POLYMARKET_MARKETS_FETCH_LIMIT_PER_TAG=50
POLYMARKET_MARKETS_INCLUDE_MANUAL_PINS=1
POLYMARKET_MARKETS_ODDS_MOVE_THRESHOLD=0.05
POLYMARKET_MARKETS_VOLUME_MOVE_THRESHOLD_PCT=0.2
POLYMARKET_MARKETS_ACTIVITY_SPIKE_THRESHOLD_PCT=0.25
POLYMARKET_MARKETS_CLOSING_SOON_HOURS=72
POLYMARKET_MARKETS_CANDIDATE_COOLDOWN_HOURS=6

# Polymarket researcher
# Requires `hermes`, `python3.12`, and last30days.py.
# Default local path: ~/.codex/skills/last30days/scripts/last30days.py
# Default root/VPS path: /root/.agents/skills/last30days/scripts/last30days.py
POLYMARKET_RESEARCHER_RUN_ONCE=0
POLYMARKET_RESEARCHER_INTERVAL_MS=300000
RESEARCH_ENGINE_TOOLSETS=browser
POLYMARKET_RESEARCH_PLANNER_HERMES_TOOLSETS=browser

# Feed V3 structured inference (tool-less classify/synthesis/entity/editor calls)
INFERENCE_GATEWAY_PRIMARY_PROVIDER=ollama-cloud
INFERENCE_GATEWAY_PRIMARY_MODEL=deepseek-v4-flash
# Optional; OpenRouter fallback remains disabled unless a reviewed model is set.
# INFERENCE_GATEWAY_OPENROUTER_FALLBACK_MODEL=approved-provider/approved-model
# Optional dedicated Hermes profile for structured one-shot calls.
# INFERENCE_GATEWAY_HERMES_PROFILE=myboon-structured
# Optional per-workload admission/reasoning policy. Unlisted workloads retain
# the code-owned low-effort, 4-concurrent, 60-calls/minute defaults.
# INFERENCE_GATEWAY_WORKLOAD_POLICIES_JSON={"research.synthesis":{"reasoningEffort":"low","maxConcurrency":2,"rateLimit":{"maxCalls":30,"windowMs":60000}}}

# Feed V3 migration controls. Safe defaults keep every new worker off.
FEED_V3_INTAKE_MODE=off
FEED_V3_RESEARCH_MODE=off
FEED_V3_ENTITY_MODE=off
FEED_V3_ACTIVE_SOURCES=
FEED_V3_SHADOW_SOURCES=
# Prefer stage-specific source ownership. The two global variables above are
# compatibility fallbacks and should stay empty for new deployments.
FEED_V3_INTAKE_ACTIVE_SOURCES=
FEED_V3_INTAKE_SHADOW_SOURCES=
FEED_V3_RESEARCH_ACTIVE_SOURCES=
FEED_V3_RESEARCH_SHADOW_SOURCES=
FEED_V3_ENTITY_ACTIVE_SOURCES=
FEED_V3_ENTITY_SHADOW_SOURCES=
FEED_V3_LEGACY_RESEARCH_DISABLED_SOURCES=
FEED_V3_LEGACY_ENTITY_DISABLED_SOURCES=
# News/Polymarket legacy Research and Entity runners consume their stage's same
# ownership values and receipt before opening SQLite/Supabase/Hermes. Change a
# set only with the ordered PM2 cutover/rollback sequence in docs/DEPLOY.md.
# Required before either shared lane may become active. The reviewed manifest
# binds source/stage parity evidence and rollback rehearsal to an expiry.
FEED_V3_CUTOVER_RECEIPT_PATH=
FEED_V3_SHADOW_SAMPLE_BASIS_POINTS=0
FEED_V3_DEEP_RESEARCH_ENABLED=0
# Deep remains fail-closed when enabled unless every containment setting below
# is explicit. The contained executable must implement the job, trusted usage
# sidecar, and fetched-evidence manifest contract; durable execution rows are
# source-routed into news.sqlite/pipeline.sqlite. Do not place credentials here.
FEED_V3_DEEP_RESEARCH_WORKER_EXECUTABLE=
FEED_V3_DEEP_RESEARCH_WORKER_CONTRACT_VERSION=myboon.deep_worker.v1
FEED_V3_DEEP_RESEARCH_WORKER_ARGS_JSON=[]
FEED_V3_DEEP_RESEARCH_APPROVED_DOMAINS=
# Optional input to the read-only OS egress verifier. This does not configure
# systemd or the firewall and is not a substitute for hostname-binding proof.
FEED_V3_DEEP_RESEARCH_EGRESS_ALLOWED_CIDRS=
FEED_V3_DEEP_RESEARCH_CAPABILITIES=browser_navigation,registered_search,http_fetch
FEED_V3_DEEP_RESEARCH_PROVIDER=
FEED_V3_DEEP_RESEARCH_MODEL=
FEED_V3_DEEP_RESEARCH_PROMPT_VERSION=research.deep.prompt.v1
FEED_V3_DEEP_RESEARCH_MAX_BROWSER_NAVIGATIONS=3
FEED_V3_DEEP_RESEARCH_MAX_SEARCH_QUERIES=3
FEED_V3_DEEP_RESEARCH_MAX_HTTP_FETCHES=4
FEED_V3_DEEP_RESEARCH_MAX_OUTPUT_BYTES=100000
FEED_V3_DEEP_RESEARCH_CPU_QUOTA_PERCENT=50
FEED_V3_DEEP_RESEARCH_MEMORY_MAX_BYTES=536870912
FEED_V3_DEEP_RESEARCH_TASKS_MAX=64
FEED_V3_DEEP_RESEARCH_REASONING_EFFORT=low
FEED_V3_DEEP_RESEARCH_MAX_CONCURRENCY=4
FEED_V3_DEEP_RESEARCH_RATE_MAX_CALLS=60
FEED_V3_DEEP_RESEARCH_RATE_WINDOW_MS=60000
# Dedicated existing roots outside the repository/home. One root may be used
# for both lists; broad roots such as / and /tmp are rejected.
FEED_V3_DEEP_RESEARCH_AUDIT_TEMP_ROOTS=
FEED_V3_DEEP_RESEARCH_AUDIT_PROFILE_ROOTS=
FEED_V3_DEEP_RESEARCH_AUDIT_LIMIT=100
FEED_V3_DEEP_RESEARCH_AUDIT_INTERVAL_MS=300000
FEED_V3_DEEP_RESEARCH_RUNTIME_STATUS_PATH=/absolute/path/to/feed-v3-deep-runtime-status.json
# Rules-only triage is the production default. A classifier is unavailable
# unless both this flag and an injected gateway adapter are configured.
FEED_V3_TRIAGE_CLASSIFIER_ENABLED=0
FEED_V3_TRIAGE_PROVIDER_HEALTH=unavailable
# Light is the only admitted depth until a reviewed standard connector or the
# VPS-verified deep worker is available. Unsupported decisions are deferred;
# they are never silently downgraded.
FEED_V3_TRIAGE_ALLOWED_DEPTHS=light

# Shared Research runner. Mode off means zero DB/provider/network I/O. Shadow
# results stay source-local in news.sqlite or pipeline.sqlite.
FEED_V3_RESEARCH_RUN_ONCE=0
FEED_V3_RESEARCH_INTERVAL_MS=5000
FEED_V3_RESEARCH_BATCH_SIZE=10
FEED_V3_RESEARCH_PROMPT_VERSION=research.synthesis.prompt.v1
FEED_V3_RESEARCH_URGENT_PRIORITIES=P0,P1
FEED_V3_RESEARCH_BACKGROUND_PRIORITIES=P2,P3
FEED_V3_RESEARCH_MAX_CONSECUTIVE_CLAIMS_PER_SOURCE=2
FEED_V3_RESEARCH_RECOVERY_INTERVAL_MS=30000
FEED_V3_RESEARCH_RECOVERY_LIMIT_PER_SOURCE=100
FEED_V3_RESEARCH_DRAIN_GRACE_MS=150000
FEED_V3_RESEARCH_RUNTIME_STATUS_PATH=.data/feed-v3-research-runtime-status.json
FEED_V3_RESEARCH_RUNTIME_STATUS_STALE_MS=60000
# Durable operator drain/resume gate shared by Research and Entity workers.
FEED_V3_RUNTIME_CONTROL_PATH=.data/feed-v3-runtime-control.json
# Standard research stays unavailable until both a code-registered connector
# and a reviewed policy are configured.
# FEED_V3_STANDARD_SEARCH_CONNECTOR=
# FEED_V3_STANDARD_SEARCH_POLICY_VERSION=

# Shared Entity worker. Source ownership remains legacy while mode is off.
FEED_V3_ENTITY_RUN_ONCE=0
FEED_V3_ENTITY_INTERVAL_MS=30000
FEED_V3_ENTITY_BATCH_SIZE=10
FEED_V3_ENTITY_RUNTIME_STATUS_PATH=.data/feed-v3-entity-runtime-status.json
FEED_V3_ENTITY_RUNTIME_STATUS_STALE_MS=60000

# Optional reviewed alert thresholds. JSON values are credential-free.
# FEED_V3_STATUS_ALERT_POLICY_JSON={"queueAgeSloMs":{"news":{"P0":900000,"P1":7200000}},"providerErrorRateThreshold":0.1,"deadLetterCountThreshold":1}
# FEED_V3_OPERATIONAL_ALERT_POLICY_JSON={"minimumThroughputWindowMs":1800000,"minimumCompletionAdmissionRatio":1,"sqliteWriteErrorCountThreshold":0}
FEED_V3_STATUS_ACTIVITY_WINDOW_MS=1800000
FEED_V3_DRAIN_STATUS_STALE_MS=60000
FEED_V3_SQLITE_WRITE_ERROR_JOURNAL_PATH=.data/feed-v3-sqlite-write-errors.jsonl
FEED_V3_SQLITE_WRITE_ERROR_HEARTBEAT_STALE_MS=300000

ENTITY_MANAGER_POLYMARKET_RUN_ONCE=0
ENTITY_MANAGER_POLYMARKET_INTERVAL_MS=300000
ENTITY_MANAGER_POLYMARKET_BATCH_SIZE=20
ENTITY_MANAGER_POLYMARKET_MAX_AGE_MS=172800000
ENTITY_MANAGER_POLYMARKET_LEASE_MS=7200000
ENTITY_MANAGER_POLYMARKET_MAX_ATTEMPTS=3
ENTITY_MANAGER_POLYMARKET_RETRY_BASE_MS=300000

# Read-only VPS preflight
POLYMARKET_DOCTOR_SLUG=will-the-fed-increase-interest-rates-by-25-bps-after-the-july-2026-meeting

# Generic publisher from editor_drafts to published_narratives
PUBLISHER_RUN_ONCE=0
PUBLISHER_INTERVAL_MS=300000
PUBLISHER_BATCH_SIZE=10
PUBLISHER_PREVIEW_ONLY=0

# Hyperliquid perps connector
# Public Hyperliquid reads do not require an API key. Supabase env is required only for writes.
HYPERLIQUID_RUN_ONCE=1
HYPERLIQUID_PREVIEW_ONLY=0
HYPERLIQUID_STORAGE=supabase
HYPERLIQUID_SQLITE_PATH=.data/hyperliquid.sqlite
HYPERLIQUID_EVALUATION_INTERVAL_HOURS=4
HYPERLIQUID_EVALUATION_DELAY_MS=120000
HYPERLIQUID_TOP_MARKET_COUNT=20
HYPERLIQUID_CANDLE_LOOKBACK_HOURS=50
HYPERLIQUID_FUNDING_LOOKBACK_HOURS=25
HYPERLIQUID_PRICE_CHANGE_1H_THRESHOLD_PCT=5
HYPERLIQUID_PRICE_CHANGE_4H_THRESHOLD_PCT=7
HYPERLIQUID_EXTREME_FUNDING_RATE_THRESHOLD=0.0005
HYPERLIQUID_FUNDING_MOVE_THRESHOLD=0.00005
HYPERLIQUID_PRICE_FUNDING_MOVE_PRICE_THRESHOLD_PCT=3
HYPERLIQUID_VOLUME_SPIKE_THRESHOLD_PCT=100
HYPERLIQUID_WEIGHTED_CANDIDATE_THRESHOLD=55
HYPERLIQUID_CANDIDATE_DEDUPE_HOURS=4
