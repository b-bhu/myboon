{
  "name": "@myboon/collectors",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "exports": {
    "./entity-manager": {
      "types": "./src/entity-manager/public.ts",
      "import": "./src/entity-manager/public.ts",
      "default": "./src/entity-manager/public.ts"
    },
    "./signal-platform": {
      "types": "./src/signal-platform/public.ts",
      "import": "./src/signal-platform/public.ts",
      "default": "./src/signal-platform/public.ts"
    }
  },
  "scripts": {
    "polymarket:markets-data-engineer": "tsx src/polymarket/run-markets-data-engineer.ts",
    "polymarket:researcher": "tsx src/polymarket/run-researcher.ts",
    "polymarket:doctor": "tsx src/polymarket/run-doctor.ts",
    "hyperliquid:collector": "tsx src/hyperliquid/run-collector.ts",
    "hyperliquid:collector:sqlite": "HYPERLIQUID_STORAGE=sqlite tsx src/hyperliquid/run-collector.ts",
    "hyperliquid:sqlite:inspect": "tsx src/hyperliquid/inspect-sqlite.ts",
    "entity-manager:polymarket": "tsx src/entity-manager/run-polymarket.ts",
    "entity-manager:news": "tsx src/entity-manager/run-news.ts",
    "editor-draft": "tsx src/editor-draft/run.ts",
    "editor-draft:preview": "tsx src/editor-draft/preview.ts",
    "publisher": "tsx src/publisher/run.ts",
    "publisher:preview": "tsx src/publisher/preview.ts",
    "world-cup:pre-match": "tsx src/world-cup/run-pre-match.ts",
    "news:research": "tsx src/news/run-news.ts",
    "news:feed:ingest": "tsx src/news/run-news-feed-ingestor.ts",
    "hermes:orphan-sweeper": "tsx src/hermes/run-orphan-sweeper.ts",
    "build": "tsc",
    "pipeline-store:backup": "tsx src/pipeline-store/run-backup.ts",
    "pipeline-store:status": "tsx src/pipeline-store/run-status.ts",
    "pipeline-store:recover-research": "tsx src/pipeline-store/run-recover-failures.ts --stage research",
    "pipeline-store:recover-entity-manager": "tsx src/pipeline-store/run-recover-failures.ts --stage entity-manager",
    "pipeline-store:dead-letters": "tsx src/pipeline-store/run-dead-letter-status.ts",
    "test:pipeline-ledger": "tsx --test src/pipeline-ledger.test.ts",
    "test:pipeline-store": "tsx --test src/pipeline-store/*.test.ts",
    "test:news": "tsx --test src/news/tests/*.test.ts",
    "test:world-cup": "tsx --test src/world-cup/*.test.ts",
    "test:markets-data-engineer": "tsx --test src/polymarket/markets-data-engineer.test.ts",
    "test:researcher": "tsx --test src/polymarket/researcher.test.ts src/polymarket/egress-guards.test.ts",
    "test:hyperliquid": "tsx --test src/hyperliquid/*.test.ts",
    "test:entity-manager": "tsx --test src/entity-manager/*.test.ts",
    "test:editor-draft": "tsx --test src/editor-draft/*.test.ts",
    "test:publisher": "tsx --test src/publisher/*.test.ts",
    "test:inference-gateway": "tsx --test src/inference-gateway/*.test.ts",
    "test:signal-platform": "tsx --test src/signal-platform/*.test.ts src/signal-platform/adapters/*.test.ts",
    "test:signal-platform:operators": "tsx --test src/signal-platform/operator-*.test.ts",
    "feed-v3:status": "tsx src/signal-platform/run-status.ts",
    "feed-v3:recover": "tsx src/signal-platform/run-recovery.ts",
    "feed-v3:trace": "tsx src/signal-platform/run-trace.ts"
  },
  "dependencies": {
    "@myboon/shared": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "agent-browser": "0.34.0",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
