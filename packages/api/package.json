{
  "name": "@myboon/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "smoke": "tsx src/smoke-test.ts",
    "e2e:featured-markets": "tsx src/e2e/api-e2e.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:internal": "tsx --test src/internal/*.test.ts",
    "test:feed": "tsx --test src/stories/*.test.ts src/hyperliquid/*.test.ts",
    "test:latest-updates": "tsx --test src/latest-updates/*.test.ts",
    "calendar:releases": "tsx src/calendar/run-releases.ts",
    "calendar:backfill": "tsx src/calendar/run-releases.ts --backfill",
    "test:wallet-move": "tsx --test src/wallet-move/*.test.ts",
    "test:wallet-summary": "tsx --test src/wallet-summary/*.test.ts src/wallet-summary/venues/*.test.ts",
    "test:phoenix": "tsx --test src/phoenix/*.test.ts",
    "tokens:icons": "tsx scripts/fetch-token-icons.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ellipsis-labs/rise": "0.4.9",
    "@hono/node-server": "^1.13.0",
    "@myboon/shared": "workspace:*",
    "@supabase/supabase-js": "2.98.0",
    "dotenv": "^16.0.0",
    "ethers": "5",
    "hono": "^4.6.0",
    "pg": "8.16.3",
    "tslib": "^2.8.1",
    "viem": "^2.47.12",
    "ws": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@polymarket/client": "0.12.0",
    "@types/node": "^25.3.5",
    "@types/pg": "8.15.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
