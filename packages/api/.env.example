SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_DASHBOARD_TOKEN=
INTERNAL_ENTITY_WRITE_TOKEN=
INTERNAL_POLYMARKET_CATALOG_WRITE_TOKEN=
PORT=3000
HOST=0.0.0.0
# Server-only RPC endpoints. Keep provider credentials out of client URLs.
# SOLANA_RPC_URL takes precedence for the proxy; HELIUS_RPC_URL remains the
# compatibility fallback and is still used by the server's /spot route.
SOLANA_RPC_URL=
HELIUS_RPC_URL=
SOLANA_DEVNET_RPC_URL=
POLYGON_RPC_URL=
SOLANA_WS_RPC_URL=
SOLANA_DEVNET_WS_RPC_URL=
# Set only when a trusted reverse proxy overwrites these client IP headers.
TRUST_PROXY_HEADERS=0
# Server-only Jupiter gateway configuration. Never prefix these with EXPO_PUBLIC_.
JUP_API_KEY=
JUP_API_BASE=https://api.jup.ag
SWAP_PRIORITY_FEE_MAX_LAMPORTS=1000000
SWAP_SQLITE_PATH=.data/swap.sqlite
# Set to 1 to stop new signable orders; already-submitted executions remain recoverable.
SWAP_TRADING_KILL_SWITCH=0
# Set to 0 to disable the anonymous Backpack earnings/economic calendar route.
CALENDAR_BACKPACK_ENABLED=true
# Server-only Birdeye Data API key for sampled KOL/smart-trader wallet activity.
# The token heatmap uses JUP_API_KEY and Jupiter-verified tokens.
BIRDEYE_API_KEY=
