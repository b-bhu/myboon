SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_DASHBOARD_TOKEN=
INTERNAL_ENTITY_WRITE_TOKEN=
INTERNAL_POLYMARKET_CATALOG_WRITE_TOKEN=
PORT=3000
HOST=0.0.0.0
# Helius RPC URL (with API key) — required by the /spot route (Wallet's Spot balance data)
HELIUS_RPC_URL=
# Server-only Jupiter gateway configuration. Never prefix these with EXPO_PUBLIC_.
JUP_API_KEY=
JUP_API_BASE=https://api.jup.ag
SWAP_PRIORITY_FEE_MAX_LAMPORTS=1000000
SWAP_SQLITE_PATH=.data/swap.sqlite
# Set to 1 to stop new signable orders; already-submitted executions remain recoverable.
SWAP_TRADING_KILL_SWITCH=0
