EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_JUP_API_KEY=
EXPO_PUBLIC_SOLANA_RPC_URL=
# Set to "testnet" to point Pacific perps at test-api.pacifica.fi (no real funds)
EXPO_PUBLIC_PACIFIC_ENV=mainnet
# Pacific builder code for fee sharing (register at pacifica.fi)
EXPO_PUBLIC_PACIFIC_BUILDER_CODE=MYB00N

# Turnkey (embedded Polygon wallet for Polymarket)
EXPO_PUBLIC_TURNKEY_ORG_ID=
EXPO_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=

# Privy
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Privy in the browser (@privy-io/react-auth), off by default.
#
# Native uses @privy-io/expo, which does not run in a browser — so without this
# the EVM path is device-only, and Privy is the only backend that can satisfy
# EVM. Set to 1 to log in and activate an EVM wallet from a browser:
#
#   EXPO_PUBLIC_PRIVY_WEB=1 pnpm --filter hybrid-expo web
#
# Solana on web still comes from the wallet-adapter extensions, not Privy.
EXPO_PUBLIC_PRIVY_WEB=
